#! ia 1.0

@authoring-guide public-agent-system-agent
  meaning
    says "Names a participant and the vocabulary to which its governance applies. It does not grant host permissions."
    answers "When should I use @agent, and what should I check before authoring it?"
  reference
    owner agent-system
    word agent
    schema @schema agent
    document ".ia/src/systems/authoring-system/reference/agent.md"
    default-file "agent.ia"
  guidance
    select-when "Identify a participant and the vocabulary addressed by its governance."
    avoid-when "Use @agent-profile for capability composition or @mandate for bounded authority."
    consider "Give the participant an unambiguous identity; host permissions require separate authorization."
  relationships
    cites @schema agent

@authoring-guide public-agent-composition-system-agent-profile
  meaning
    says "Composes an agent, capabilities, optional mandate/voice/delegates and installed execution contracts."
    answers "When should I use @agent-profile, and what should I check before authoring it?"
  reference
    owner agent-composition-system
    word agent-profile
    schema @schema agent-profile
    document ".ia/src/systems/authoring-system/reference/agent-profile.md"
    default-file "agent-profile.ia"
  guidance
    select-when "Compose a participant with capabilities and optional voice, mandate or delegates."
    avoid-when "Use @agent for identity or @harness for workspace-level execution composition."
    consider "Resolve every selected capability and binding; composition does not establish that the host installed them."
  relationships
    cites @schema agent-profile

@authoring-guide public-taxonomy-artifact-set
  meaning
    says "Defines a closed grouping of artifact genres."
    answers "When should I use @artifact-set, and what should I check before authoring it?"
  reference
    owner taxonomy
    word artifact-set
    schema @schema kernel-artifact-set
    document ".ia/src/systems/authoring-system/reference/artifact-set.md"
    default-file "artifact-set.ia"
  guidance
    select-when "Group artifact genres for classification and filtering."
    avoid-when "Use @distribution to select concrete roots for packaging or @kind for semantic role."
    consider "Distinguish source specifications from generated outputs inside a genre; membership does not prove provenance."
  relationships
    cites @schema kernel-artifact-set

@authoring-guide public-authoring-system-authoring-guide
  meaning
    says "Associates a vocabulary owner and schema with an authoring reference and usage guidance."
    answers "When should I use @authoring-guide, and what should I check before authoring it?"
  reference
    owner authoring-system
    word authoring-guide
    schema @schema authoring-guide
    document ".ia/src/systems/authoring-system/reference/authoring-guide.md"
    default-file "authoring-guide.ia"
  guidance
    select-when "Link a registered word and its schema to advice for selecting and authoring that word."
    avoid-when "Use @playbook for a procedure or @schema for the structural contract itself."
    consider "Explain nearest alternatives and minimum useful content; keep document references and resource pins synchronized."
  relationships
    cites @schema authoring-guide

@authoring-guide public-taxonomy-axis
  meaning
    says "Defines a closed coordinate axis for selection."
    answers "When should I use @axis, and what should I check before authoring it?"
  reference
    owner taxonomy
    word axis
    schema @schema kernel-axis
    document ".ia/src/systems/authoring-system/reference/axis.md"
    default-file "axis.ia"
  guidance
    select-when "Define a closed coordinate axis used to select context."
    avoid-when "Use @dimension for a supported record attribute or @intent-shape for retrieval defaults."
    consider "Keep axis values and the actor or runtime that supplies them consistent with the position protocol."
  relationships
    cites @schema kernel-axis

@authoring-guide public-agent-composition-system-capability
  meaning
    says "Groups operations, procedures, templates, checks and included capabilities with declared execution bounds."
    answers "When should I use @capability, and what should I check before authoring it?"
  reference
    owner agent-composition-system
    word capability
    schema @schema capability
    document ".ia/src/systems/authoring-system/reference/capability.md"
    default-file "capability.ia"
  guidance
    select-when "Group related operations, procedures, templates and checks under declared execution bounds."
    avoid-when "Use @operation for one executable contract or @agent-profile to select capabilities for a participant."
    consider "Resolve included capabilities and their limits; test effect and authority bounds at the execution boundary."
  relationships
    cites @schema capability

@authoring-guide public-taxonomy-cardinality
  meaning
    says "Defines relationship multiplicity constraints."
    answers "When should I use @cardinality, and what should I check before authoring it?"
  reference
    owner taxonomy
    word cardinality
    schema @schema kernel-cardinality
    document ".ia/src/systems/authoring-system/reference/cardinality.md"
    default-file "cardinality.ia"
  guidance
    select-when "Define the multiplicity accepted for a relationship target."
    avoid-when "Use a schema required marker for field presence; relationship multiplicity is a separate constraint."
    consider "Prefer may one for an optional single edge; preserve optional as a compatibility alias and test requiredness separately."
  relationships
    cites @schema kernel-cardinality

@authoring-guide public-compliance-system-case
  meaning
    says "Declares scenario inputs, expected behavior and evaluator attribution. A declaration is not an observed test result."
    answers "When should I use @case, and what should I check before authoring it?"
  reference
    owner compliance-system
    word case
    schema @schema case
    document ".ia/src/systems/authoring-system/reference/case.md"
    default-file "case.ia"
  guidance
    select-when "Describe reproducible scenario inputs, a request and its expected success or refusal."
    avoid-when "Use @check to name an evaluator or @observation to record an observed result."
    consider "Bind the case to an executable assertion and expected code where relevant; declaring a case does not run it."
  relationships
    cites @schema case

@authoring-guide public-taxonomy-category
  meaning
    says "Defines a closed concept classification used by record shapes and contextual selection."
    answers "When should I use @category, and what should I check before authoring it?"
  reference
    owner taxonomy
    word category
    schema @schema kernel-category
    document ".ia/src/systems/authoring-system/reference/category.md"
    default-file "category.ia"
  guidance
    select-when "Define a concept classification used by record shapes and contextual selection."
    avoid-when "Use @kind for semantic role or @dimension for a condition and lookup coordinate."
    consider "Check all registered shapes and selectors that consume the closed category set."
  relationships
    cites @schema kernel-category

@authoring-guide public-compliance-system-check
  meaning
    says "Names a check implementation and scope. Declaring an implementation name does not install or execute it."
    answers "When should I use @check, and what should I check before authoring it?"
  reference
    owner compliance-system
    word check
    schema @schema check
    document ".ia/src/systems/authoring-system/reference/check.md"
    default-file "check.ia"
  guidance
    select-when "Name an evaluator implementation and the scope it is intended to assess."
    avoid-when "Use @case for scenario inputs and expectations or @observation for an actual evaluation result."
    consider "Verify that the host installs the named evaluator and that its evidence identifies the evaluated subject revision."
  relationships
    cites @schema check

@authoring-guide public-compliance-system-contract
  meaning
    says "Names versioned requirements that may be adopted by other records. Requirements need explicit evaluation evidence."
    answers "When should I use @contract, and what should I check before authoring it?"
  reference
    owner compliance-system
    word contract
    schema @schema contract
    document ".ia/src/systems/authoring-system/reference/contract.md"
    default-file "contract.ia"
  guidance
    select-when "State versioned requirements that other records can adopt and evaluators can assess."
    avoid-when "Use @schema for field structure or @law for a governing rule."
    consider "Give requirements stable identifiers and connect checks, cases and current evidence without treating adoption as proof."
  relationships
    cites @schema contract

@authoring-guide public-governance-system-convention
  meaning
    says "Declares a convention in the shared governance shape."
    answers "When should I use @convention, and what should I check before authoring it?"
  reference
    owner governance-system
    word convention
    schema @schema convention
    document ".ia/src/systems/authoring-system/reference/convention.md"
    default-file "convention.ia"
  guidance
    select-when "Record a shared practice that keeps authoring or operation consistent."
    avoid-when "Use @law for a rule with severity or @principle for the rationale behind a practice."
    consider "Describe a concrete practice and its intended subjects; cite an existing rule instead of restating it."
  relationships
    cites @schema convention

@authoring-guide public-work-system-decision
  meaning
    says "Represents a choice that is needed or has been made: the question, options and decider, and once made, the choice and rationale."
    answers "When should I use @decision, and what should I check before authoring it?"
  reference
    owner work-system
    word decision
    schema @schema decision
    document ".ia/src/systems/authoring-system/reference/decision.md"
    default-file "decision.ia"
  guidance
    select-when "Record a question, options and decider, then the selected choice and rationale when made."
    avoid-when "Use @task for implementation work or @improvement for a proposal awaiting review."
    consider "Keep status consistent with the choice; pin historical evidence while current policy decisions refer to maintained sources."
  relationships
    cites @schema decision

@authoring-guide public-taxonomy-dimension
  meaning
    says "Defines a supported record dimension used by conditions and lookup."
    answers "When should I use @dimension, and what should I check before authoring it?"
  reference
    owner taxonomy
    word dimension
    schema @schema kernel-dimension
    document ".ia/src/systems/authoring-system/reference/dimension.md"
    default-file "dimension.ia"
  guidance
    select-when "Define a record coordinate supported by conditions and lookup."
    avoid-when "Use @axis for a closed selection axis or an ordinary field for data with no selector semantics."
    consider "Confirm that a consumer actually interprets the dimension; naming it alone does not implement a condition."
  relationships
    cites @schema kernel-dimension

@authoring-guide public-workspace-system-distribution
  meaning
    says "Declares root records from which a distributable closure is selected."
    answers "When should I use @distribution, and what should I check before authoring it?"
  reference
    owner workspace-system
    word distribution
    schema @schema distribution
    document ".ia/src/systems/authoring-system/reference/distribution.md"
    default-file "distribution.ia"
  guidance
    select-when "Select root records whose dependency closure is to be packaged."
    avoid-when "Use @workspace for a working source boundary or @template for rendering structure."
    consider "Choose roots that exclude repository-only maintenance records; qualification must inspect the resulting archive bytes."
  relationships
    cites @schema distribution

@authoring-guide public-agent-composition-system-execution-binding
  meaning
    says "Connects a native target to a host-installed entry or operation descriptor."
    answers "When should I use @execution-binding, and what should I check before authoring it?"
  reference
    owner agent-composition-system
    word execution-binding
    schema @schema execution-binding
    document ".ia/src/systems/authoring-system/reference/execution-binding.md"
    default-file "execution-binding.ia"
  guidance
    select-when "Connect a native target to an entry or descriptor installed by a host."
    avoid-when "Use @operation for the implementation contract or @harness to compose bindings."
    consider "Qualify against the actual host catalog; absent installations are unavailable evidence, not successful bindings."
  relationships
    cites @schema execution-binding

@authoring-guide public-agent-composition-system-harness
  meaning
    says "Composes profiles and execution bindings in a workspace under a host contract."
    answers "When should I use @harness, and what should I check before authoring it?"
  reference
    owner agent-composition-system
    word harness
    schema @schema harness
    document ".ia/src/systems/authoring-system/reference/harness.md"
    default-file "harness.ia"
  guidance
    select-when "Compose profiles and execution bindings for a workspace under a host contract."
    avoid-when "Use @agent-profile for one participant composition or @workspace for source selection."
    consider "Check workspace and binding compatibility and retain qualification evidence for the actual installed host."
  relationships
    cites @schema harness

@authoring-guide public-hook-authoring-system-hook
  meaning
    says "Represents a host event, tool/path selection and guard message. Registration and executing a guard require a host adapter."
    answers "When should I use @hook, and what should I check before authoring it?"
  reference
    owner hook-authoring-system
    word hook
    schema @schema hook
    document ".ia/src/systems/authoring-system/reference/hook.md"
    default-file "hook.ia"
  guidance
    select-when "Describe a host event and selection guard with its response message."
    avoid-when "Use @operation for an executable contract or @law for a rule independent of host events."
    consider "Verify registration and event matching in the host adapter; declaration alone neither registers nor executes a guard."
  relationships
    cites @schema hook

@authoring-guide public-learning-system-improvement
  meaning
    says "Represents a proposed change, review metadata and publication metadata. It does not authorize or apply the proposal."
    answers "When should I use @improvement, and what should I check before authoring it?"
  reference
    owner learning-system
    word improvement
    schema @schema improvement
    document ".ia/src/systems/authoring-system/reference/improvement.md"
    default-file "improvement.ia"
  guidance
    select-when "Propose a change with review and publication metadata."
    avoid-when "Use @observation for supporting evidence or @decision for the choice to accept a proposal."
    consider "Describe the proposed change and review basis; keep approval, application and publication evidence separate."
  relationships
    cites @schema improvement

@authoring-guide public-taxonomy-intent-shape
  meaning
    says "Defines a request framing and its retrieval defaults."
    answers "When should I use @intent-shape, and what should I check before authoring it?"
  reference
    owner taxonomy
    word intent-shape
    schema @schema kernel-intent-shape
    document ".ia/src/systems/authoring-system/reference/intent-shape.md"
    default-file "intent-shape.ia"
  guidance
    select-when "Frame a request with retrieval defaults for its purpose."
    avoid-when "Use @primitive to select a cognitive operation explicitly or @playbook to supply a procedure."
    consider "Document default phase, primitive and delivery bounds; retain explicit caller overrides."
  relationships
    cites @schema kernel-intent-shape

@authoring-guide public-taxonomy-kind
  meaning
    says "Defines a closed semantic role for records; lowering determines the role of each registered word."
    answers "When should I use @kind, and what should I check before authoring it?"
  reference
    owner taxonomy
    word kind
    schema @schema kernel-kind
    document ".ia/src/systems/authoring-system/reference/kind.md"
    default-file "kind.ia"
  guidance
    select-when "Classify the semantic role produced by lowering a registered word."
    avoid-when "Use @category for concept classification or @artifact-set for artifact genre."
    consider "Keep the closed role set consistent with lowering and retrieval lanes before changing registration metadata."
  relationships
    cites @schema kernel-kind

@authoring-guide public-taxonomy-lane
  meaning
    says "Defines a retrieval lane associated with record kinds."
    answers "When should I use @lane, and what should I check before authoring it?"
  reference
    owner taxonomy
    word lane
    schema @schema kernel-lane
    document ".ia/src/systems/authoring-system/reference/lane.md"
    default-file "lane.ia"
  guidance
    select-when "Define the retrieval channel associated with a record kind."
    avoid-when "Use @placement for source authority; a lane does not assign source precedence."
    consider "Keep lane mappings consistent with lowering and delivery; the authority lane contains governance records and authority-facet contracts."
  relationships
    cites @schema kernel-lane

@authoring-guide public-governance-system-law
  meaning
    says "Declares a rule with severity. Structural admission cannot establish the truth or suitability of its prose."
    answers "When should I use @law, and what should I check before authoring it?"
  reference
    owner governance-system
    word law
    schema @schema law
    document ".ia/src/systems/authoring-system/reference/law.md"
    default-file "law.ia"
  guidance
    select-when "State a rule whose violations have a declared severity."
    avoid-when "Use @principle for governing rationale or @convention for an agreed practice."
    consider "Connect the rule to intended subjects with operative relationships or path scope and verify delivery from their seats."
  relationships
    cites @schema law

@authoring-guide public-agent-system-mandate
  meaning
    says "States bounded authority and conditions for a participant. Host authorization remains independent. An authority section names the participant it binds, the closed moves it allows, the workspaces it scopes, the words it excludes and the paths it covers."
    answers "When should I use @mandate, and what should I check before authoring it?"
  reference
    owner agent-system
    word mandate
    schema @schema mandate
    document ".ia/src/systems/authoring-system/reference/mandate.md"
    default-file "mandate.ia"
  guidance
    select-when "State bounded participant authority with allowed moves, workspace scope and exclusions."
    avoid-when "Use @agent for participant identity or @contract for requirements independent of a grant."
    consider "Bind the intended participant and explicit scope; confirm host authorization before executing an allowed move."
  relationships
    cites @schema mandate

@authoring-guide public-work-system-milestone
  meaning
    says "Represents an outcome with an exit criterion inside exactly one plan; it names a condition, not the work toward it."
    answers "When should I use @milestone, and what should I check before authoring it?"
  reference
    owner work-system
    word milestone
    schema @schema milestone
    document ".ia/src/systems/authoring-system/reference/milestone.md"
    default-file "milestone.ia"
  guidance
    select-when "Name an outcome and exit criterion within exactly one plan."
    avoid-when "Use @task for the action toward that outcome or @plan for the overarching arrangement."
    consider "Make exit observable and keep it aligned with the evidence required of its tasks."
  relationships
    cites @schema milestone

@authoring-guide public-taxonomy-move
  meaning
    says "Defines the closed classification of an agent action or activity."
    answers "When should I use @move, and what should I check before authoring it?"
  reference
    owner taxonomy
    word move
    schema @schema kernel-move
    document ".ia/src/systems/authoring-system/reference/move.md"
    default-file "move.ia"
  guidance
    select-when "Classify the action or activity that a participant may undertake."
    avoid-when "Use @operation for an executable implementation contract or @primitive for cell selection."
    consider "Use the closed move vocabulary in authority bounds; a declared allowed move does not grant host permission."
  relationships
    cites @schema kernel-move

@authoring-guide public-learning-system-observation
  meaning
    says "Represents an attributed evidence account with interpretation and retention metadata. Evidence claims are not verified by field typing."
    answers "When should I use @observation, and what should I check before authoring it?"
  reference
    owner learning-system
    word observation
    schema @schema observation
    document ".ia/src/systems/authoring-system/reference/observation.md"
    default-file "observation.ia"
  guidance
    select-when "Record an attributed account of evidence, its interpretation and retention."
    avoid-when "Use @case for an expectation or @improvement for a proposed change based on evidence."
    consider "Identify the evaluated subject revision, verdict and concrete evidence; distinguish an unavailable check from a pass."
  relationships
    cites @schema observation

@authoring-guide public-authoring-system-operation
  meaning
    says "Binds a declared operation to an implementation/input/output/effect contract; the host installs implementations."
    answers "When should I use @operation, and what should I check before authoring it?"
  reference
    owner authoring-system
    word operation
    schema @schema operation
    document ".ia/src/systems/authoring-system/reference/operation.md"
    default-file "operation.ia"
  guidance
    select-when "Declare an implementation contract with inputs, outputs and effects for host execution."
    avoid-when "Use @playbook for procedure text or @template for bounded rendering inputs."
    consider "Define success and refusal behavior and test the installed adapter; naming an implementation does not install it."
  relationships
    cites @schema operation

@authoring-guide public-taxonomy-phase
  meaning
    says "Defines a cognitive phase coordinate: orient, plan, act or learn."
    answers "When should I use @phase, and what should I check before authoring it?"
  reference
    owner taxonomy
    word phase
    schema @schema kernel-phase
    document ".ia/src/systems/authoring-system/reference/phase.md"
    default-file "phase.ia"
  guidance
    select-when "Name a cognitive stage used to select procedure cells."
    avoid-when "Use @primitive for the cognitive operation or @run for an execution instance."
    consider "Use orient, plan, act or learn; a declared phase does not prove that execution reached it."
  relationships
    cites @schema kernel-phase

@authoring-guide public-taxonomy-placement
  meaning
    says "Defines source authority and reach metadata."
    answers "When should I use @placement, and what should I check before authoring it?"
  reference
    owner taxonomy
    word placement
    schema @schema kernel-placement
    document ".ia/src/systems/authoring-system/reference/placement.md"
    default-file "placement.ia"
  guidance
    select-when "Define source authority, precedence and reach within a captured workspace."
    avoid-when "Use @lane for retrieval routing or @workspace sources to select actual source roots."
    consider "Check placement band and reach together; location metadata does not grant disclosure authority."
  relationships
    cites @schema kernel-placement

@authoring-guide public-work-system-plan
  meaning
    says "Represents an arrangement of milestones toward an intent; it heads the work hierarchy and has no parent. Plans do not nest."
    answers "When should I use @plan, and what should I check before authoring it?"
  reference
    owner work-system
    word plan
    schema @schema plan
    document ".ia/src/systems/authoring-system/reference/plan.md"
    default-file "plan.ia"
  guidance
    select-when "Arrange milestones toward an intent at the top of the work hierarchy."
    avoid-when "Use @milestone for one outcome or @task for an owned action; plans do not nest."
    consider "State intent and status, connect milestones and reference maintained sources instead of copying mutable release values."
  relationships
    cites @schema plan

@authoring-guide public-governance-system-playbook
  meaning
    says "Represents a procedure as phase/primitive cells. Cell delivery is generic; the authored method belongs to its author."
    answers "When should I use @playbook, and what should I check before authoring it?"
  reference
    owner governance-system
    word playbook
    schema @schema playbook
    document ".ia/src/systems/authoring-system/reference/playbook.md"
    default-file "playbook.ia"
  guidance
    select-when "Provide a procedure whose cells are selected by phase and primitive."
    avoid-when "Use @operation for an executable implementation or @authoring-guide for choosing and writing records."
    consider "Cover the intended phase and primitive combinations, including refusal or escalation where needed; cell delivery is not execution."
  relationships
    cites @schema playbook

@authoring-guide public-taxonomy-predicate
  meaning
    says "Defines a directed relationship and its inverse spelling."
    answers "When should I use @predicate, and what should I check before authoring it?"
  reference
    owner taxonomy
    word predicate
    schema @schema kernel-predicate
    document ".ia/src/systems/authoring-system/reference/predicate.md"
    default-file "predicate.ia"
  guidance
    select-when "Define a directed relationship with its inverse spelling."
    avoid-when "Use a schema field for scalar data; avoid a new predicate for an existing relationship spelling."
    consider "Specify direction, canonical spelling and inverse consistently; participating systems must consent to the edge."
  relationships
    cites @schema kernel-predicate

@authoring-guide public-taxonomy-primitive
  meaning
    says "Defines a cognitive primitive coordinate; a cell is selected using its phase and primitive."
    answers "When should I use @primitive, and what should I check before authoring it?"
  reference
    owner taxonomy
    word primitive
    schema @schema kernel-primitive
    document ".ia/src/systems/authoring-system/reference/primitive.md"
    default-file "primitive.ia"
  guidance
    select-when "Name the cognitive operation paired with a phase to select a procedure cell."
    avoid-when "Use @move for an action classification or @intent-shape for request framing."
    consider "Check cell coverage for explicit primitive selection and preserve intent-shape defaults when no override is given."
  relationships
    cites @schema kernel-primitive

@authoring-guide public-governance-system-principle
  meaning
    says "Declares a governing rationale in the shared governance shape."
    answers "When should I use @principle, and what should I check before authoring it?"
  reference
    owner governance-system
    word principle
    schema @schema principle
    document ".ia/src/systems/authoring-system/reference/principle.md"
    default-file "principle.ia"
  guidance
    select-when "Explain a governing rationale used to judge choices across cases."
    avoid-when "Use @law for a severity-bearing rule or @convention for a customary practice."
    consider "State the tradeoff the rationale resolves and its scope so it can guide a decision without duplicating a rule."
  relationships
    cites @schema principle

@authoring-guide public-session-system-run
  meaning
    says "Represents a governed run identity, status, owner and declared phase when known. Declaration does not start execution."
    answers "When should I use @run, and what should I check before authoring it?"
  reference
    owner session-system
    word run
    schema @schema run
    document ".ia/src/systems/authoring-system/reference/run.md"
    default-file "run.ia"
  guidance
    select-when "Identify a governed execution and record its status and any known phase."
    avoid-when "Use @task for intended work or @observation for execution evidence."
    consider "Keep journal-only runs phase-free when no live phase is known; status and ownership declarations do not start execution."
  relationships
    cites @schema run

@authoring-guide public-floor-schema
  meaning
    says "Declares the structural contract for exactly one registered discriminator."
    answers "When should I use @schema, and what should I check before authoring it?"
  reference
    owner floor
    word schema
    schema @schema schema
    document ".ia/src/systems/authoring-system/reference/schema.md"
    default-file "schema.ia"
  guidance
    select-when "Define the fields, sections and relationships accepted for one registered word."
    avoid-when "Use @contract for evaluated behavioral requirements; a schema cannot prove those requirements."
    consider "Match the registered discriminator and owner; distinguish required structure from host-enforced semantic conditions."
  relationships
    cites @schema schema

@authoring-guide public-work-system-spec
  meaning
    says "Represents a maintained specification with explicit status and at most one same-word supersession. Contents and document membership belong to its author; a source locator does not load a body or prove semantic quality."
    answers "When should I use @spec, and what should I check before authoring it?"
  reference
    owner work-system
    word spec
    schema @schema spec
    document ".ia/src/systems/authoring-system/reference/spec.md"
    default-file "spec.ia"
  guidance
    select-when "Maintain a specification with explicit status and optional same-word supersession."
    avoid-when "Use @contract for evaluable requirement adoption or @task for work implementing the specification."
    consider "Keep at most one supersession and identify maintained content; a source locator neither loads nor verifies its document body."
  relationships
    cites @schema spec

@authoring-guide public-floor-system
  meaning
    says "Registers vocabulary, direct system dependencies, a local steward and consent for relationships."
    answers "When should I use @system, and what should I check before authoring it?"
  reference
    owner floor
    word system
    schema @schema system
    document ".ia/src/systems/authoring-system/reference/system.md"
    default-file "system.ia"
  guidance
    select-when "Introduce a vocabulary owner with registered words, direct dependencies and relationship consent."
    avoid-when "Use @workspace to select existing systems; use @schema to describe one word within its owner."
    consider "Name a local steward, declare only direct dependencies and check consent at both ends of every cross-system edge."
  relationships
    cites @schema system

@authoring-guide public-work-system-task
  meaning
    says "Represents one owner's action toward exactly one milestone. Whether it is ready to start is computed by a work evaluator, never stored on the record."
    answers "When should I use @task, and what should I check before authoring it?"
  reference
    owner work-system
    word task
    schema @schema task
    document ".ia/src/systems/authoring-system/reference/task.md"
    default-file "task.ia"
  guidance
    select-when "Assign one owner an action toward exactly one milestone."
    avoid-when "Use @milestone for the resulting condition or @spec for maintained requirements."
    consider "State expected artifacts and prerequisites; exit evidence must succeed at the current task revision and does not change work.status."
  relationships
    cites @schema task

@authoring-guide public-template-system-template
  meaning
    says "Represents bounded rendering inputs and output structure. Rendering does not publish or install output."
    answers "When should I use @template, and what should I check before authoring it?"
  reference
    owner template-system
    word template
    schema @schema template
    document ".ia/src/systems/authoring-system/reference/template.md"
    default-file "template.ia"
  guidance
    select-when "Describe bounded inputs and output structure for rendering."
    avoid-when "Use @operation for a broader executable effect or @spec for maintained requirements."
    consider "Scalar templates require parameters and lines; structured-v1 templates use their resource and may omit those legacy fields or keep empty lists."
  relationships
    cites @schema template

@authoring-guide public-taxonomy-value-type
  meaning
    says "Defines the field types that schemas may require."
    answers "When should I use @value-type, and what should I check before authoring it?"
  reference
    owner taxonomy
    word value-type
    schema @schema kernel-value-type
    document ".ia/src/systems/authoring-system/reference/value-type.md"
    default-file "value-type.ia"
  guidance
    select-when "Define a field value type available to canonical schemas."
    avoid-when "Use @schema for a particular word contract or @cardinality for relationship multiplicity."
    consider "Keep parsing, schema validation and author-facing type rendering aligned before adding a type."
  relationships
    cites @schema kernel-value-type

@authoring-guide public-agent-composition-system-voice
  meaning
    says "Declares communication attributes separate from authority and procedure."
    answers "When should I use @voice, and what should I check before authoring it?"
  reference
    owner agent-composition-system
    word voice
    schema @schema voice
    document ".ia/src/systems/authoring-system/reference/voice.md"
    default-file "voice.ia"
  guidance
    select-when "Specify communication attributes to compose into an agent profile."
    avoid-when "Use @mandate for authority or @playbook for procedure; tone does not supply either."
    consider "Make attributes actionable for the intended audience and check they do not smuggle in execution permissions."
  relationships
    cites @schema voice

@authoring-guide public-workspace-system-workspace
  meaning
    says "Groups systems into an explicit work boundary; relationships can describe dependencies between boundaries. Its sources name the roots and placement bands its records are captured from, and its steward the agent that directs it by default."
    answers "When should I use @workspace, and what should I check before authoring it?"
  reference
    owner workspace-system
    word workspace
    schema @schema workspace
    document ".ia/src/systems/authoring-system/reference/workspace.md"
    default-file "workspace.ia"
  guidance
    select-when "Select systems and source roots for an explicit work boundary."
    avoid-when "Use @system to own vocabulary or @distribution to select packaging roots."
    consider "Declare source placements and an appropriate steward; validate the selected closure before using it."
  relationships
    cites @schema workspace
