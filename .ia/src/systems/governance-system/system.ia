#! ia 1.0

@system governance-system
  provider "inventarch.foundation"
  version "1.1.0"
  describes "Public governance-system vocabulary contracts"
  steward @agent public-governance-system-steward
  requires
    - agent-system
    - compliance-system
    - workspace-system
  discriminators
    law lowers to governance
      category rule
      facets [law]
      schema @schema law
      artifact-set principle
      primitive Inference
      move Verification
    principle lowers to governance
      category rule
      facets [principle]
      schema @schema principle
      artifact-set principle
      primitive Inference
      move Synthesis
    convention lowers to governance
      category rule
      facets [convention]
      schema @schema convention
      artifact-set principle
      primitive Inference
      move Synthesis
    playbook lowers to definition
      category process
      facets [procedure]
      schema @schema playbook
      artifact-set principle
      primitive Inference
      move Synthesis
  edges
    cite * using *
    govern * using *
    enforce * using *
    implement * using *
    require * using *
    use * using *

@agent public-governance-system-steward
  meaning
    says "Identifies the owner of governance-system contracts in this example."
    answers "Who owns the law, principle, convention and playbook words in this example?"
  governance
    applies [law, principle, convention, playbook]
