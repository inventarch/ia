#! ia 1.0

@schema run
  lowers to definition
  sections
    must have meaning
    must have execution
    may have relationships
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have execution.status as id
    may have execution.phase as id "The declared phase, when known; omit it when unknown. Historical id values remain valid. A declaration does not prove engine state."
    must have execution.owner as ref
