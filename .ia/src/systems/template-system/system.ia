#! ia 1.0

@system template-system
  provider "inventarch.local"
  version "3.1.2"
  describes "Public template-system vocabulary contracts"
  steward @agent public-template-system-steward
  requires
    - agent-system
    - governance-system
    - compliance-system
    - authoring-system
  discriminators
    template lowers to template
      category representation
      facets [template]
      schema @schema template
      artifact-set projection
      primitive Decision
      move Execution
  edges
    cite * using *
    govern * using *
    enforce * using *
    implement * using *
    require * using *
    use * using *

@agent public-template-system-steward
  meaning
    says "Accountable owner of template-system vocabulary, canonical schemas, relationship consent and direct dependencies."
    answers "Who owns the template word?"
  governance
    applies [template]
