{
  "name": "@inventarch/template-system",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./internal/index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/scalar": {
      "types": "./dist/scalar.d.ts",
      "default": "./dist/scalar.js"
    },
    "./internal/structured": {
      "types": "./dist/structured.d.ts",
      "default": "./dist/structured.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "LICENSE",
    "NOTICE",
    "LANGUAGE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@inventarch/language": "workspace:*",
    "@inventarch/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal/contract": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "./internal/index": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal/scalar": {
        "types": "./dist/scalar.d.ts",
        "default": "./dist/scalar.js"
      },
      "./internal/structured": {
        "types": "./dist/structured.d.ts",
        "default": "./dist/structured.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inventarch/ia.git",
    "directory": ".ia/src/systems/template-system"
  }
}
