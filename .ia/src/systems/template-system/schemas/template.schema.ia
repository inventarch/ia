#! ia 1.0

@schema template
  lowers to template
  sections
    must have meaning
    must have template
    may have relationships
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have template.filename as text
    may have template.parameters as list of id "The scalar renderer requires declared parameters; structured-v1 may omit this field or retain an empty list."
    may have template.lines as list of text "The scalar renderer requires content lines; structured-v1 may omit this field or retain an empty list."
    may have template.profile as id
    may have template.resource as text
