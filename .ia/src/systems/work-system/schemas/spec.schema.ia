#! ia 1.0

@schema spec
  lowers to contract
  sections
    must have meaning
    must have work
    may have relationships
    closed
  fields
    must have meaning.says as text
    may have meaning.answers as text
    must have work.title as text
    must have work.status as id in [draft, accepted, superseded, withdrawn]
    may have work.owner as text
    may have work.start as text form iso-date
    may have work.due as text form iso-date
    may have work.ended as text form iso-date
    may have work.source as text
    may have work.covers as list of text "Path selections the spec claims, matched by the location resolver."
    may have work.replaced-scope as text "What a superseding spec replaces when it does not replace the whole predecessor."
  edges
    may supersede spec one
    may grounded-by decision one
