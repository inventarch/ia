#! ia 1.0

@system work-system
  provider "inventarch.local"
  version "1.1.0"
  describes "Public work-system vocabulary contracts"
  steward @agent public-work-system-steward
  requires
    - agent-system
    - governance-system
    - compliance-system
  discriminators
    plan lowers to definition
      category process
      facets [plan]
      schema @schema plan
      artifact-set product-definition
      primitive Inference
      move Synthesis
    milestone lowers to definition
      category state
      facets [milestone]
      schema @schema milestone
      artifact-set product-definition
      primitive Inference
      move Verification
    task lowers to definition
      category process
      facets [task]
      schema @schema task
      artifact-set execution
      primitive Decision
      move Execution
    decision lowers to definition
      category decision
      facets [decision]
      schema @schema decision
      artifact-set decision
      primitive Decision
      move Synthesis
    spec lowers to contract
      category rule
      facets [spec]
      schema @schema spec
      artifact-set contract
      primitive Memory
      move Observation
  edges
    cite * using *
    require task, milestone, decision using task, milestone, any-adopter
    require contract, spec using spec
    supersede plan using plan
    supersede milestone using milestone
    supersede task using task
    supersede decision using decision
    supersede spec using spec
    ground plan, milestone, task, spec using decision, any-adopter

@agent public-work-system-steward
  meaning
    says "Identifies the owner of work-system contracts in this example."
    answers "Who owns the plan, milestone, task, decision and spec words in this example?"
  governance
    applies [plan, milestone, task, decision, spec]
