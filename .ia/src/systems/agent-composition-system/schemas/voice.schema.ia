#! ia 1.0

@schema voice
  lowers to definition
  sections
    must have meaning
    must have communication
    may have relationships
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have communication.tone as text
    must have communication.terminology as text
    must have communication.explanation as text
    must have communication.uncertainty as text
    may have communication.audience as id
    may have communication.citations as text
