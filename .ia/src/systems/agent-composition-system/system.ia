#! ia 1.0

@system agent-composition-system
  provider "inventarch.local"
  version "1.2.0"
  describes "Public agent-composition-system vocabulary contracts"
  steward @agent public-agent-composition-system-steward
  requires
    - agent-system
    - workspace-system
    - governance-system
    - compliance-system
    - authoring-system
    - template-system
  discriminators
    voice lowers to definition
      category property
      facets [voice]
      schema @schema voice
      artifact-set product-definition
      primitive Attention
      move Synthesis
    agent-profile lowers to binding
      category capability
      facets [agent-profile]
      schema @schema agent-profile
      artifact-set execution
      primitive Decision
      move Execution
    harness lowers to definition
      category boundary
      facets [harness]
      schema @schema harness
      artifact-set execution
      primitive Decision
      move Execution
    capability lowers to definition
      category capability
      facets [capability]
      schema @schema capability
      artifact-set product-definition
      primitive Inference
      move Synthesis
    execution-binding lowers to binding
      category relation
      facets [execution-binding]
      schema @schema execution-binding
      artifact-set execution
      primitive Decision
      move Execution
  edges
    cite * using *
    govern * using *
    enforce * using *
    implement * using *
    require * using *
    use * using *

@agent public-agent-composition-system-steward
  meaning
    says "Identifies the owner of agent-composition-system contracts in this example."
    answers "Who owns the voice, agent-profile, harness, capability and execution-binding words in this example?"
  governance
    applies [voice, agent-profile, harness, capability, execution-binding]
