#! ia 1.0

@workspace language-workspace
  meaning
    says "The public systems that define the IA language vocabulary."
    answers "Which vocabulary contracts compose the public language?"
  composition
    systems [@system agent-system, @system compliance-system, @system workspace-system, @system governance-system, @system session-system, @system authoring-system, @system agent-composition-system, @system template-system, @system hook-authoring-system, @system learning-system, @system work-system]
    sources [".ia/src @authored"]

@distribution language-distribution
  meaning
    says "The root of the public language vocabulary closure."
    answers "Which workspace starts the public language distribution?"
  distribution
    records [@workspace language-workspace]
