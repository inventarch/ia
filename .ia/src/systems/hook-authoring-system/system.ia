#! ia 1.0

@system hook-authoring-system
  provider "inventarch.local"
  version "3.1.2"
  describes "Public hook-authoring-system vocabulary contracts"
  steward @agent public-hook-authoring-system-steward
  requires
    - agent-system
    - governance-system
    - compliance-system
    - authoring-system
  discriminators
    hook lowers to binding
      category capability
      facets [hook]
      schema @schema hook
      artifact-set operational
      primitive Escalation
      move Execution
  edges
    cite * using *
    govern * using *
    enforce * using *
    implement * using *
    require * using *
    use * using *

@agent public-hook-authoring-system-steward
  meaning
    says "Accountable owner of hook-authoring-system vocabulary, canonical schemas, relationship consent and direct dependencies."
    answers "Who owns the hook word?"
  governance
    applies [hook]
