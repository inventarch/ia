#! ia 1.0

@system session-system
  provider "inventarch.foundation"
  version "0.1.0"
  describes "Public session-system vocabulary contracts"
  steward @agent public-session-system-steward
  requires
    - agent-system
    - workspace-system
    - governance-system
  discriminators
    run lowers to definition
      category event
      facets [run]
      schema @schema run
  edges
    cite * using *
    govern * using *
    enforce * using *
    implement * using *
    require * using *
    use * using *

@agent public-session-system-steward
  meaning
    says "Identifies the owner of session-system contracts in this example."
    answers "Who owns the run word in this example?"
  governance
    applies [run]
