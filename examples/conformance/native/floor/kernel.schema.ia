#! ia 1.0

@schema kernel-kind
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have data.lane as id
    may have data.authority-lane as id

@schema kernel-category
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

@schema kernel-lane
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

@schema kernel-phase
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

@schema kernel-primitive
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have data.anchor as id

@schema kernel-move
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

@schema kernel-predicate
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have data.inverse as id
    must have data.phrase as text

@schema kernel-axis
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have data.values as list of id

@schema kernel-dimension
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have data.values as list of id
    must have data.path as text

@schema kernel-intent-shape
  lowers to definition
  sections
    must have meaning
    must have data
    must have routing
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have routing.category as id
    must have routing.primitive as id
    must have routing.tie-precedence as number
    must have routing.kind-focus as list of id
    must have routing.lane-focus as list of id
    must have routing.predicate-focus as list of id
    may have routing.priming-order as list of id

@schema kernel-artifact-set
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

@schema kernel-placement
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number
    must have data.band as number

@schema kernel-value-type
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

@schema kernel-cardinality
  lowers to definition
  sections
    must have meaning
    must have data
    closed
  fields
    must have meaning.says as text
    must have meaning.answers as text
    must have data.order as number

