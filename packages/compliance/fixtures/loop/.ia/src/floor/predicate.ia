#! ia 1.0

@predicate govern
  meaning
    says "X governs Y — Y is subject to X's authority and rules (inverse: governed-by). The authority edge."
    answers "Is this edge an authority relation?"
  data
    order 0
    inverse governed-by
    phrase "governs"

@predicate enforce
  meaning
    says "X enforces Y — X actively applies or checks Y at a crossing (inverse: enforced-by). The enforcement edge."
    answers "Is this edge an enforcement relation?"
  data
    order 1
    inverse enforced-by
    phrase "enforces"

@predicate ground
  meaning
    says "X grounds Y — X is the evidence or basis Y rests on (inverse: grounded-by). The grounding edge."
    answers "Is this edge a grounding relation?"
  data
