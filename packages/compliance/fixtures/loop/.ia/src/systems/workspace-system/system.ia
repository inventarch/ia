#! ia 1.0

@system workspace-system
  provider "inventarch.foundation"
  version "0.1.0"
  describes "Composed work boundaries and distributable record closures"
  steward @agent workspace-steward
  requires
    - agent-system
    - compliance-system
  discriminators
    workspace lowers to definition
      category boundary
      facets [workspace]
      schema @schema workspace
    distribution lowers to definition
      category representation
      facets [distribution]
      schema @schema distribution
  edges
    cite * using *
    govern * using *
    enforce * using *
    implement * using *
    require * using *
    use * using *
