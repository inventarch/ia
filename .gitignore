# Local IA state and retained working evidence
.ia/.iadb/
.ia/work/
.ia/distributions/

# Dependencies and emitted packages (kept locally for validation)
node_modules/
dist/
*.tsbuildinfo
*.vsix

# The bundled base package, generated by tools/native/language-base.ts during the root build
/apps/cli/assets/base/
/apps/cli/assets/base.json

# Codicon assets copied from @vscode/codicons by the apps/vscode build
/apps/vscode/media/codicon.css
/apps/vscode/media/codicon.ttf

# The host payload, generated by tools/distribution/host-payload.mjs during the root build
/apps/cli/assets/host/
/apps/cli/assets/host.json

# Repository scratch and browser output
/.work/
/.superpowers/
/.playwright-cli/
/output/
/.cache/
/.turbo/
/.vscode-test/
/.claude/settings.local.json
/.claude/worktrees/
/lefthook-local.yml
/lefthook-local.yaml

# Generated test reports; source fixtures remain visible
/coverage/
/test-results/
/playwright-report/
/blob-report/
/apps/*/coverage/
/apps/*/test-results/
/apps/*/playwright-report/
/apps/*/blob-report/
/packages/*/coverage/
/packages/*/test-results/
/.ia/src/systems/*/coverage/
/.ia/src/systems/*/test-results/

# Local environment secrets; checked-in templates remain available
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Package-manager diagnostics and operating-system metadata
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
Desktop.ini

# Task evidence and restored task outputs
/artifacts/

# Nx local task cache and daemon state
/.nx/

# Private installed development host native assets, emitted by the owning CLI build
/apps/cli/assets/development-native/
/apps/cli/assets/development-native.json
