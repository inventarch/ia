  "changes": [
    {
      "id": "judge-a-held-user-host-lock-from-one-opened-file",
      "title": "Judge a held user host lock from one opened file",
      "summary": "When `ia host claude --user` finds its lock, `<IA home>/claude/.lock`, held by another run, @inventarch/distribution now judges whether that lock is stale from one opened file: its type, age and pid all come from a single descriptor, and a stale lock is removed only after its name is found, while that descriptor is open, to still name the judged file (CodeQL js/file-system-race). A lock that replaced the judged file before that check is therefore no longer removed; a brief window between the check and the removal remains, as Node has no unlink-if-same. A symbolic link or other non-regular file at the lock path now counts as busy and is not taken over, and a FIFO at the lock path no longer hangs the takeover; each refuses IA-DIST-INSTALL-BUSY, as does a lock file the run cannot open. Locks the CLI writes are judged as before: taken over once their pid has died, after 10 minutes, or after 10 seconds when their pid is empty or unparseable. The IA-DIST-INSTALL-BUSY message is unchanged.",
      "packages": [
        "@inventarch/distribution"
      ],
      "paths": [
        "apps/distribution/"
      ]
    },
    {
      "id": "reuse-one-ia-home-across-the-checkpoint-converge",
      "title": "Reuse one IA home across the checkpoint convergence test passes",
      "summary": "Test-only: the CLI's checkpoint convergence test writes the host payload once instead of on every pass. No behaviour changes for consumers.",
      "packages": [
        "@inventarch/cli"
      ],
      "paths": [
        "apps/cli/tests/"
      ]
    },
    {
      "id": "verify-the-host-payload-once-per-ia-host-apply",
      "title": "Verify the host payload once per ia host apply",
      "summary": "ia host --apply shares one verification of the host payload (about 1,400 files) between its MCP plan and its projection pre-check, so an apply scans the payload fewer times. Each step that writes still verifies afresh, so a payload that changes during the command still refuses the apply. In @inventarch/distribution, planHost, planHookRegistration and materializeHostPayload take an optional verify parameter for that shared verification: only a verifier from hostVerifier (./host-observe) is shared, and any other function is ignored in favour of a fresh check.",
      "packages": [
        "@inventarch/cli",
        "@inventarch/distribution"
      ],
      "paths": [
        "apps/cli/",
        "apps/distribution/"
      ]
    },
    {
