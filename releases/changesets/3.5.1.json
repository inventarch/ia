  "changes": [
    {
      "id": "check-current-authority-before-returning-an-agen",
      "title": "Check current authority before returning an agent session",
      "summary": "Engine.advance now checks the current grant for the session root profile before returning session state, including terminal, paused, waiting and cancelled advances. Revoked or expired authority is refused even when no scheduler step runs.",
      "packages": [
        "@inventarch/agent-system"
      ],
      "paths": [
        ".ia/src/systems/agent-system/"
      ]
    },
    {
      "id": "check-publication-recovery-when-session-authorit",
      "title": "Check publication recovery when session authority expires",
      "summary": "The publication recovery regression now expects expired authority to deny the returned session while checking that recovery evidence remains persisted.",
      "packages": [
        "@inventarch/agent-system",
        "@inventarch/workspace-runtime"
      ],
      "paths": [
        ".ia/src/systems/agent-system/",
        "packages/workspace-runtime/"
      ]
    },
    {
      "id": "keep-the-repository-workspace-resolvable-beside",
      "title": "Keep the repository workspace resolvable beside domain roots",
      "summary": "A unique admitted workspace in .ia/src/workspace.ia is now the repository default even when it declares no sources and another workspace does. Multiple workspaces at that entry point remain ambiguous; repositories without an admitted entry-point workspace retain the previous selection fallback. Domain workspaces can declare their own sources without making the repository default ambiguous. Source membership and mandate restrictions are unchanged.",
      "packages": [
        "@inventarch/db",
        "@inventarch/runtime"
      ],
      "paths": [
        "packages/db/",
        "packages/runtime/"
      ]
    },
    {
      "id": "pin-more-of-the-database-contract-with-tests",
      "title": "Pin more of the database contract with tests",
      "summary": "Tests only: pins refusals, limits and read-only rules that @inventarch/db already applies. No package behaviour changes.",
      "packages": [
        "@inventarch/db"
      ],
      "paths": [
        "packages/db/",
        "tools/"
      ]
    },
    {
      "id": "read-an-installation-through-a-linked-root-and-k",
      "title": "Read an installation through a linked root and keep adopted trees' line endings",
      "summary": "readInstalledGeneration and readExpandedBundle now canonicalize the root as open does, so the ia_kb_* tools and other readers work when --root reaches the workspace through a link; a link inside the installation is still refused. ia adopt and ia init --adopt write .ia/open/.gitattributes with * -text -filter -ident -working-tree-encoding unless a regular file is already there, which keeps checkouts from converting pinned bytes unless a higher-precedence git attribute says otherwise. A bound tree that matches its pin once CRLF becomes LF is now refused with the conversion named, instead of a plain revision mismatch.",
      "packages": [
        "@inventarch/cli",
        "@inventarch/db",
        "@inventarch/distribution",
        "@inventarch/kb"
      ],
      "paths": [
        "apps/cli/",
        "apps/distribution/",
        "packages/db/",
        "packages/kb/"
      ]
    },
    {
      "id": "cohort-alignment",
      "title": "Coordinated version alignment",
      "summary": "Package version metadata follows the coordinated 3.5.1 release; each native artifact version follows its own archive content.",
