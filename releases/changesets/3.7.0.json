  "changes": [
    {
      "id": "honor-shared-authored-root-ownership-in-cli-edit",
      "title": "Honor exact shared authored-root ownership in CLI edits",
      "summary": "Preview and author match root containment and shared ownership using exact native declaration spelling on every platform. Differently cased foreign roots cannot borrow the repository workspace authored placement; foreign child roots, adopted placement and mandate checks remain protected.",
      "packages": [
        "@inventarch/cli"
      ],
