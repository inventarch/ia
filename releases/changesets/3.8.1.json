  "changes": [
    {
      "id": "catalogs-that-rename-only-an-operation-s-validat",
      "title": "Catalogs that rename only an operation's validators or an entry's mapping compile",
      "summary": "compileHarness now compares the input and output validators an operation descriptor lists, and the mapping an entry contract lists, with the names a record resolves to by installed name, as it already compares models. A catalog whose alias table renames an operation's validators but not the operation, or an entry's mapping but not the entry, was refused with IA-COMPOSITION-CONFLICT and now compiles. The alias such a listed name relies on is recorded in provenance.aliases, so compiledAliases still rebuilds the harness. A listed name the alias table sends to another entry is still refused, and compilations that already succeeded are unaffected. installedReadAdapters requires each read validator the compiled harness pins, found through its recorded aliases, to equal the first-party validator the read lists: when only the read's validators are renamed, a changed replacement, or one that is the read's other validator, is refused, and the original validator entries the harness no longer uses need not be installed.",
      "packages": [
        "@inventarch/agent-composition-system",
        "@inventarch/runner"
      ],
      "paths": [
        ".ia/authoring.resources.json",
        ".ia/src/systems/agent-composition-system/",
        "apps/runner/"
      ]
    },
    {
      "id": "regenerated-vocabulary-and-language-compatibilit",
      "title": "Regenerated vocabulary and language compatibility assets",
      "summary": "The bundled vocabulary assets carry the new native system versions. The bundled language bases and compatibility index keep every published base, 3.3.0 included, and add 3.3.1, the base this release builds, as the newest; a workspace locked to a published base still restores offline, and the language floors the CLI computes are unchanged. No consumer-facing change.",
      "packages": [
        "@inventarch/cli",
        "@inventarch/mcp-door"
      ],
      "paths": [
        ".ia/authoring.resources.json",
        "CLAUDE.md",
        "apps/cli/",
        "apps/mcp-door/",
        "docs/",
        "examples/",
        "tools/"
      ]
    },
    {
      "id": "workspace-runtime-docs-the-agent-composition-ali",
      "title": "Workspace runtime docs: the agent-composition aliases are gone",
      "summary": "Docs only: the provenance note now says IA 3.8.0 removed the agent-composition-system aliases of this package's modules; no package behaviour changes.",
      "packages": [
        "@inventarch/workspace-runtime"
      ],
      "paths": [
        "docs/",
        "packages/workspace-runtime/"
      ]
    },
