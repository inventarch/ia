  "changes": [
    {
      "id": "count-array-scans-not-milliseconds-in-the-linear",
      "title": "Count array scans, not milliseconds, in the linear-postings test",
      "summary": "Test only: the linear-time posting test counts array scans instead of timing loads, so runner speed can no longer fail it. No consumer-facing change.",
      "packages": [
        "@inventarch/graph"
      ],
      "paths": [
        "packages/graph/"
      ]
    },
    {
      "id": "read-the-ia-range-a-kit-release-works-with",
      "title": "Read the IA range a kit release works with",
      "summary": "A kit's release row may now name `works`, the range of IA versions (`@inventarch/cli`) the release works with, beside `cli`, the version that packed it. The method resolver reads a kit whose latest release names `works` with every reader the range admits and refuses any other with IA-CORE-CLI-UNSUPPORTED, so a new IA release inside the range needs no new kit release. A `works` that is not a SemVer range admitting some release, one that only a prerelease satisfies included, refuses IA-CORE-KIT. A release without `works` keeps the earlier packed-major rule.",
      "packages": [
        "@inventarch/runtime"
      ],
      "paths": [
        "packages/runtime/",
        "docs/specs/kit-runtime/"
      ]
    },
    {
      "id": "restore-cached-releases-without-the-default-registry",
      "title": "Restore cached releases while the default registry is not provisioned",
      "summary": "`ia restore` no longer refuses with IA-DIST-ARTIFACT-UNAVAILABLE when a locked kit's only registry is the built-in default and that default serves no registry (it answers without `ia-registry.json`). Such a kit, installed from a catalog or a directory, is restored from the verified archive in the workspace cache; the result warns that no registry was asked whether it was withdrawn and names it, and `--json` lists it in `unchecked`. This is what stopped the console's upgrade recipe at its restore step. A kit that is not cached, a default registry that is failing instead of absent, and every configured registry refuse as before. `@inventarch/distribution/registry` adds `restoreWithdrawals`; `registryWithdrawals` is unchanged.",
      "packages": [
        "@inventarch/cli",
        "@inventarch/distribution"
      ],
      "paths": [
        "apps/cli/",
        "apps/distribution/",
        "docs/specs/registry/"
      ]
    },
    {
