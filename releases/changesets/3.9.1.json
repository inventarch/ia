  "changes": [
    {
      "id": "kb-committed-git-retry",
      "title": "Committed kb reads retry a timed-out git call once",
      "summary": "Committed reads in `@inventarch/kb`, which `kb pack` and the legacy committed writer use, now give a git call that timed out, such as one a stalled process held past its 10-second bound, one more try under the same bound before refusing with `IA-KB-SOURCE-UNAVAILABLE`. Any other git failure still refuses at once. The 10-second default and the 30-second cap on `gitTimeoutMs` stay as they are. A git call that times out on both tries refuses after its second try, about 20 seconds at the default.",
      "packages": [
        "@inventarch/kb"
      ],
      "paths": [
        "packages/kb/"
      ]
    },
    {
      "id": "let-a-workspace-that-declares-a-root-twice-own-i",
      "title": "Let a workspace that declares a root twice own it",
      "summary": "ia preview and ia author judged an authored root one declaration row at a time, so a workspace that declares the same root both `@authored` and `@adopted` (the adopted twin a governing store keeps for adopters) was refused IA-CLI-EDIT-UNOWNED at its own root. Ownership is now judged per declaring workspace: every declarer must declare the root `@authored`, and a declarer that holds only the `@adopted` twin still withholds it.",
      "packages": [
        "@inventarch/cli"
      ],
      "paths": [
        "apps/cli/"
      ]
    },
    {
      "id": "cohort-alignment",
      "title": "Coordinated version alignment",
      "summary": "Package version metadata follows the coordinated 3.9.1 release; each native artifact version follows its own archive content.",
